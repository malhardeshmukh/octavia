{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    /* Fonts */
    --font-primary-family: 'Inter', -apple-system, system-ui, sans-serif;
    
    /* Colors */
    --color-primary: #d63a0f;
    --color-primary-hover: #a02b0a;
    --color-primary-active: #b3300c;
    --color-primary-soft: #fdece6;
    --color-on-primary: #ffffff;
    --color-ink: #ffffff;
    --color-body: #a8a8a8;
    --color-body-strong: #ffffff;
    --color-body-on-light: #181818;
    --color-body-muted-on-light: #5c5c5c;
    --color-muted: #8a8a8a;
    --color-disabled: #b5b5b5;
    --color-hairline: #303030;
    --color-hairline-on-light: #d2d2d2;
    --color-hairline-soft: #ebebeb;
    --color-canvas: #181818;
    --color-canvas-elevated: #262626;
    --color-canvas-light: #ffffff;
    --color-surface-soft-light: #f7f7f7;
    --color-surface-strong-light: #ebebeb;
    --color-surface-product: #f4f4f2;
    --color-focus-ring: #f6e500;
    --color-focus-ring-on-light: #181818;
    --color-semantic-success: #03904a;
    --color-semantic-success-soft: #e6f5ee;
    --color-semantic-warning: #b45309;
    --color-semantic-warning-soft: #fdf1e3;
    --color-semantic-error: #c62828;
    --color-semantic-error-soft: #fbe9e9;
    --color-semantic-info: #2b6f8f;
    --color-semantic-info-soft: #e5f1f6;
    --color-overlay-scrim: rgba(24,24,24,0.6);

    /* Rounded */
    --rounded-none: 0px;
    --rounded-xs: 2px;
    --rounded-sm: 4px;
    --rounded-md: 6px;
    --rounded-lg: 8px;
    --rounded-xl: 12px;
    --rounded-full: 9999px;

    /* Spacing */
    --spacing-xxxs: 4px;
    --spacing-xxs: 8px;
    --spacing-xs: 16px;
    --spacing-sm: 24px;
    --spacing-md: 32px;
    --spacing-lg: 48px;
    --spacing-xl: 64px;
    --spacing-xxl: 96px;
    --spacing-super: 128px;
    
    --page-width: 1280px;
    --page-margin: 16px;
  }
{% endstyle %}
