{% doc %}
  Renders a custom variant picker based on the design system.

  @param {product} product - The product object
{% enddoc %}

<div class="variant-picker">
  {%- unless product.has_only_default_variant -%}
    {%- for option in product.options_with_values -%}
      <fieldset class="variant-option-group">
        <legend class="caption-uppercase">{{ option.name }}</legend>
        <div class="variant-swatches">
          {%- for value in option.values -%}
            <div class="variant-swatch-item">
              <input 
                type="radio" 
                id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" 
                name="options[{{ option.name | escape }}]" 
                value="{{ value | escape }}" 
                {% if option.selected_value == value %}checked="checked"{% endif %}
                class="visually-hidden"
              >
              <label for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="variant-swatch-text">
                {{ value }}
              </label>
            </div>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}
  {%- endunless -%}
</div>

<style>
  .variant-option-group {
    border: none;
    padding: 0;
    margin: 0 0 var(--spacing-sm);
  }
  .variant-option-group legend {
    margin-bottom: var(--spacing-xs);
    color: var(--color-body-muted-on-light);
  }
  .variant-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xxs);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
  .variant-swatch-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-canvas-light);
    color: var(--color-body-on-light);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    border: 1px solid var(--color-hairline-on-light);
    border-radius: var(--rounded-none);
    padding: 12px 20px;
    height: 48px;
    cursor: pointer;
    transition: all var(--duration-fast) var(--easing-standard);
  }
  input[type="radio"]:checked + .variant-swatch-text {
    border: 2px solid var(--color-canvas);
    padding: 11px 19px; /* adjust for border width to prevent layout shift */
  }
  input[type="radio"]:focus-visible + .variant-swatch-text {
    outline: 2px solid var(--color-focus-ring-on-light);
    outline-offset: 2px;
  }
  input[type="radio"]:disabled + .variant-swatch-text {
    opacity: 0.5;
    text-decoration: line-through;
    cursor: not-allowed;
  }
</style>
