{% comment %}
  Featured Collections Section
  Displays product collections for discovery.
{% endcomment %}

<section class="shopify-section section-padding bg-canvas-light" data-section-id="{{ section.id }}">
  <div class="collections-container">
    <div class="section-header">
      <h2 class="display-lg">{{ section.settings.heading | escape }}</h2>
    </div>
    
    <div class="collections-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <a href="{{ collection.url | default: '#' }}" class="collection-tile" {{ block.shopify_attributes }}>
          <div class="tile-media">
            {%- if collection.image -%}
              <img 
                src="{{ collection.image | image_url: width: 800 }}" 
                width="{{ collection.image.width }}"
                height="{{ collection.image.height }}"
                alt="{{ collection.title | escape }}" 
                loading="lazy"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="tile-content">
            <h3 class="title-md">{{ collection.title | default: 'Collection' }}</h3>
            <span class="item-count caption">{{ collection.all_products_count | default: 0 }} products</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .collections-container {
    padding: 0 var(--page-margin);
    max-width: var(--page-width);
    margin: 0 auto;
  }
  .section-header {
    margin-bottom: var(--spacing-lg);
  }
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-sm);
  }
  @media (min-width: 768px) {
    .collections-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .collections-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .collection-tile {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background-color: var(--color-canvas);
    color: var(--color-ink);
    border-radius: var(--rounded-none);
    overflow: hidden;
    transition: transform var(--duration-fast) var(--easing-standard);
  }
  .collection-tile:hover {
    transform: translateY(-4px);
  }
  .collection-tile:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  .tile-media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .tile-media img, .tile-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--easing-standard);
  }
  .collection-tile:hover .tile-media img {
    transform: scale(1.03);
  }
  .tile-content {
    padding: var(--spacing-sm);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxs);
  }
</style>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Machine Type"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
