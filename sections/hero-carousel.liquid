{% comment %}
  Hero Carousel Section (Full Viewport)
  "hero-band-cinema" layout from design system.
{% endcomment %}

<section class="hero-carousel" data-section-id="{{ section.id }}">
  <div class="carousel-container">
    {%- for block in section.blocks -%}
      <div class="carousel-slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        <div class="hero-media">
          {%- if block.settings.image -%}
            <img 
              src="{{ block.settings.image | image_url: width: 2400 }}" 
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              alt="{{ block.settings.title | escape }}" 
              class="hero-image"
              {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hero-image placeholder-svg' }}
          {%- endif -%}
          <div class="hero-overlay"></div>
        </div>
        
        <div class="hero-content">
          {%- if block.settings.title != blank -%}
            <h2 class="display-mega hero-title">{{ block.settings.title }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="body-lg hero-text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link }}" class="button-primary">
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  .hero-carousel {
    position: relative;
    width: 100%;
    height: 100vh; /* Full viewport height */
    overflow: hidden;
    background-color: var(--color-canvas);
    color: var(--color-ink);
  }
  
  .carousel-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--easing-standard);
    z-index: 1;
  }

  .carousel-slide.is-active {
    opacity: 1;
    z-index: 2;
  }

  .hero-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Allowed gradient for legibility over images */
  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(24,24,24,0) 40%, rgba(24,24,24,0.85) 100%);
  }

  .hero-content {
    position: absolute;
    bottom: var(--spacing-xxl);
    left: var(--spacing-md);
    right: var(--spacing-md);
    z-index: 3;
    max-width: var(--page-width);
    margin: 0 auto;
  }
  
  @media (min-width: 1024px) {
    .hero-content {
      left: calc((100% - var(--page-width)) / 2 + var(--page-margin));
      padding-right: var(--page-margin);
    }
  }

  .hero-title {
    margin-bottom: var(--spacing-xs);
    color: var(--color-ink);
  }

  .hero-text {
    margin-bottom: var(--spacing-sm);
    color: var(--color-body);
    max-width: 600px;
  }
</style>

<script>
  // Simple rotation logic for carousel.
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.carousel-slide');
    if (slides.length <= 1) return;
    
    let currentSlide = 0;
    
    setInterval(() => {
      slides[currentSlide].classList.remove('is-active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('is-active');
    }, 5000);
  });
</script>

{% schema %}
{
  "name": "Hero Carousel",
  "max_blocks": 5,
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Express your dreamed design"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Subheading",
          "default": "Asia's largest sewing machine manufacturer; Japanese-technology machines."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Machines"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
